// mayhem/harness_calc.go.src — native testing.F harness for openkruise's
// resource-expression calculator PARSER (the fuzz surface). Staged by
// mayhem/build.sh into a fresh, single-package directory (_mayhem_harness/calc)
// that also holds a copy of pkg/util/calculator's NON-test sources, so that
// go-118-fuzz-build can build it WITHOUT the upstream calculator dir's
// benchmark_test.go (testing.B breaks go-118-fuzz-build's package loader).
//
// Declared `package calculator` (the directory's package) so it reaches the
// goyacc-generated parser + hand-written lexer directly — go-118-fuzz-build
// rewrites this into an ordinary non-test .go file.
//
// Byte-in, NO file I/O (netnew §3): the fuzzer's bytes are treated as the
// expression string and handed straight to Parse(); starter seeds are Mayhem's
// job via the Mayhemfile testsuite: directive. This mirrors upstream's own
// FuzzParse in pkg/util/calculator/fuzz_test.go byte-for-byte.
package calculator

import (
	"testing"
)

// FuzzParse drives Parse() — the lexer + goyacc parser for arithmetic /
// quantity / percentage resource expressions. It must never panic on any input.
func FuzzParse(f *testing.F) {
	seeds := []string{
		"2 + 3", "10 - 4", "3 * 4", "15 / 3", "(2 + 3) * 4",
		"50%", "100% * 2", "cpu * 50%",
		"max(10, 20)", "min(10, 20)", "max(cpu, 200m)", "min(memory, 100Mi)",
		"40m + 20m", "100Mi - 50Mi", "2 * 40m", "100m / 2",
		"max(cpu * 50%, 50m)", "max(min(10, 20), 15)",
		"", "   ", "0", "0m", "0Mi",
		"1e3 + 500", "1.5e2 * 2",
		"1000Gi + 500Gi", "999999999999999999 + 1",
		"10 / 0", "-10", "-100m", "unknown(1, 2)",
		"max()", "max(10)", "max(10, 20, 30)", "(2 + 3", "()", "2 + @",
	}
	for _, seed := range seeds {
		f.Add(seed)
	}

	f.Fuzz(func(t *testing.T, expr string) {
		// Simply call Parse and ensure it doesn't panic; errors are expected.
		_, _ = Parse(expr)
	})
}
